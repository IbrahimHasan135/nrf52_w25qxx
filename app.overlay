/*
 * External W25QXX flash on Seeed XIAO nRF52840 Sense.
 *
 * Wiring (docs/W25QXX_XIAO_SPI_HELLO_WORLD_TEST.md):
 *   CS  -> D7 / P1.12   SCK -> D8 / P1.13
 *   MISO(DO) -> D9 / P1.14   MOSI(DI) -> D10 / P1.15
 *
 * Standard SPI on SPIM3, not the board's QSPI (module has no IO2/IO3).
 * Pinctrl node names must not be spi3_default/spi3_sleep: the board
 * pinctrl already defines those for other (P0.x) pins.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	aliases {
		spi-flash0 = &w25qxx;
	};
};

&pinctrl {
	w25qxx_spi3_default: w25qxx_spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 15)>,
				<NRF_PSEL(SPIM_MISO, 1, 14)>;
		};
	};

	w25qxx_spi3_sleep: w25qxx_spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 15)>,
				<NRF_PSEL(SPIM_MISO, 1, 14)>;
			low-power-enable;
		};
	};
};

/* uart0 RX uses P1.12 (D7), which is the flash CS pin. */
&uart0 {
	status = "disabled";
};

/* Board enables spi2 on the same D8-D10 pins; this app uses spi3 instead. */
&spi2 {
	status = "disabled";
};

&spi3 {
	status = "okay";
	pinctrl-0 = <&w25qxx_spi3_default>;
	pinctrl-1 = <&w25qxx_spi3_sleep>;
	pinctrl-names = "default", "sleep";
	/* Pull-up keeps CS deasserted while the MCU pins are Hi-Z during boot. */
	cs-gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

	w25qxx: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
	/* 1 MHz for bring-up over jumper wires; raise to 8 MHz once wiring is
	 * proven (see docs section 3 notes).
	 */
	spi-max-frequency = <1000000>;

	/* The module is labelled W25QXX but the chip answers JEDEC
	 * 1C 30 17 = eON EN25Q64 (8 MiB, no SFDP support). jedec-id must
	 * match the real chip because the minimal driver validates it at
	 * boot. Size is in BITS: 0x4000000 = 64 Mbit = 8 MiB.
	 */
	jedec-id = [1c 30 17];
	size = <0x4000000>;
	};
};
